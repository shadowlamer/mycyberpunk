@show_7777:
    ARTICLE(@article_7777)
    print at LAST_SCREEN_LINE, 0; ink INFO_INK; "Press Enter to play...";
    pause 0
    load "7.7.7.7"
return

@article_7777:
data "sevensevensevenseven", 1
data @text_7777_1

@text_7777_1:
data 20
data "7.7.7.7 - a dungeon crawler"
data "for ZX Spectrum."
data "Long ago, The Net was built as"
data "a trap for dark forces. But"
data "cracks scatter across it and"
data "this battle cannot be won."
data "There is just one chance: get"
data "down to the lair of Darkness"
data "and strike evil in the heart."
data "The dungeon has many creatures:"
data "Wortor sends you in loops,"
data "giant Rats want to eat you,"
data "Spiders poison and tangle you"
data "in webs, and Swinx tests you"
data "with his dark riddles."
data "Built with 8bitworkshop IDE,"
data "Tiled map editor and Furnace"
data "for chiptune music."
data "Monster graphics were generated"
data "by AI. Playable on GitHub Pages."
