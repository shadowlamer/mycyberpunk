@show_6666:
    ARTICLE(@article_6666)
return

@article_6666:
data "sixsixsixsix", 1, "6.6.6.6"
data @text_6666_1

@text_6666_1:
data 20
data "6.6.6.6 - a ZX Spectrum RPG"
data "where you are a rookie in the"
data "army of Light, a fighter against"
data "darkness and chaos, a technical"
data "support employee on their first"
data "day at work."
data "Long ago, a line of defense was"
data "built between worlds - The Net."
data "But cracks scatter across it."
data "If defenses collapse, the world"
data "will end. Your job: repair the"
data "cliffs and restart the routers."
data "Each task has two stages: ride"
data "a bike through a winding path,"
data "then answer a quiz with three"
data "options. Five attempts total."
data "The wrong answer or a fall from"
data "the bike wastes a life."
data "Written in C using SDCC."
data "Beware of puddles on the road."
