@show_nut:
    ARTICLE(@article_nut)
return

@article_nut:
data "nut", 2, ""
data @text_nut_1
data @text_nut_2

@text_nut_1:
data 20
data "Robot Battle 2025 is an"
data "international fighting robot"
data "championship. We applied but"
data "did not pass the scoring."
data "I dismantled the prototype"
data "to build a quad bike."
data ""
data "Two weeks before the event"
data "we were invited to join."
data "A friend said I should."
data "I agreed. I am bad at saying"
data "no to interesting problems."
data ""
data "Nut was built from a Bigo"
data "constructor - a Perm-made"
data "life-size set. Think Lego,"
data "but you can ride it."
data "A constructor robot at an"
data "international championship."
data ""

@text_nut_2:
data 20
data "Steel armor plates bolted to"
data "the frame, gas-powered"
data "pneumatic flipper for a"
data "weapon. Designed in Tinkercad."
data "Built in the kitchen."
data ""
data "First fight vs Mad Farmer."
data "Their weapon jammed. Nut's"
data "flipper tossed them up and"
data "over, again and again."
data "My son ran the flipper."
data "Won on points."
data ""
data "Second fight: Burevestnik,"
data "a 110kg vertical spinner."
data "One hit - power connector"
data "flew off. Nut died instantly."
data ""
data "Bolts are smashed flat."
data "Not bad for a kitchen build."
