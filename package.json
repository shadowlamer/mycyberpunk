{
  "name": "mycyberpunk",
  "version": "1.0.0",
  "description": "Website written on Sinclair BASIC",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "make-tape": "tools/maketape.sh",
    "copy": "node -e \"const fs=require('fs');fs.rmSync('docker/build',{recursive:true,force:true});fs.cpSync('dist','docker/build',{recursive:true})\"",
    "docker:build": "npm run make-tape && npm run build && npm run copy && docker build -t mycyberpunk docker"
  },
  "author": "Vadim Cherenev <sl@anhot.ru>",
  "license": "UNLICENSE",
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "jsbin2tap": "0.0.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "jquery": "^3.7.1",
    "simple-keyboard": "^3.8.54"
  }
}
